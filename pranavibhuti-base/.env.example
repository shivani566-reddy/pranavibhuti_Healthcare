# ─────────────────────────────────────────────
#  PRANAVIBHUTI — Environment Configuration
#  Copy this file to .env and fill in values.
#  NEVER commit .env to GitHub.
# ─────────────────────────────────────────────

# PostgreSQL connection (all team members use same DB)
DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/pranavibhuti

# JWT — ALL team members must use the SAME secret
JWT_SECRET_KEY=change_this_to_a_strong_random_secret_minimum_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_NAME=PRANAVIBHUTI
APP_VERSION=1.0.0
DEBUG=True
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# File uploads (Phase 3)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Notifications (Phase 3 — leave blank for now)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Razorpay (Phase 3 — leave blank for now)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AWS S3 — Health Locker (Phase 3)
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_BUCKET_NAME=
AWS_REGION=ap-south-1
